// Copy to Secrets.xcconfig and set the value to the API's APP_PASSWORD.
// Secrets.xcconfig is not in git. The app sends this as a bearer token so the
// explanation endpoint is not open to the internet; you never type it.
YOMU_API_TOKEN = replace-me

// Your Apple Development team ID, so signing survives `xcodegen generate`.
// Find it with: security find-certificate -c "Apple Development: YOUR@EMAIL" -p | openssl x509 -noout -subject
DEVELOPMENT_TEAM = XXXXXXXXXX
CODE_SIGN_STYLE = Automatic
