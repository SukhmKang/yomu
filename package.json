{
  "name": "yomu",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env backend/server.js",
    "dev": "node --env-file-if-exists=.env --watch backend/server.js",
    "test": "node --test tests/*.test.js",
    "configure:vercel": "node scripts/configure-vercel.js",
    "build": "node scripts/build-dict.js",
    "prestart": "npm run build",
    "predev": "npm run build",
    "test:ui": "playwright test",
    "start:backend": "node --env-file-if-exists=.env backend/server.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "sharp": "^0.35.4"
  }
}
